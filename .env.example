# Local env template — NEVER put a real key in a committed file.
# Copy to `.env` (gitignored) and paste your real token there for `vercel dev`.
# Production: set these in Vercel Dashboard > Project > Settings > Environment Variables.
TMDB_READ_TOKEN="paste-your-tmdb-v4-read-token-here"
# TMDB_API_KEY="paste-your-tmdb-v3-api-key-here (only if you don't use the v4 token)"
